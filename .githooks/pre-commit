#!/bin/sh
# Antes de cada commit: typecheck e testes unitários (segundos). O webview fica para o pre-push.
# Pular numa emergência: git commit --no-verify
set -e
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh" >/dev/null
  nvm use >/dev/null 2>&1 || true
fi
npm run --silent typecheck && npm run --silent test:unit
