{
  "name": "techdocs-editor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "private": true,
  "publisher": "edtroleis",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b3d6b",
    "theme": "dark"
  },
  "homepage": "https://github.com/edtroleis/vscode-techdocs-editor#readme",
  "bugs": {
    "url": "https://github.com/edtroleis/vscode-techdocs-editor/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/edtroleis/vscode-techdocs-editor.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "techdocs",
    "backstage",
    "mkdocs",
    "markdown",
    "wysiwyg",
    "docs-as-code",
    "documentation",
    "visual editor",
    "markdownlint"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:**/mkdocs.yml",
    "workspaceContains:**/mkdocs.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "techdocsEditor.visual",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "techdocsEditor.openVisual",
        "title": "%command.openVisual%",
        "category": "TechDocs",
        "icon": "$(preview)"
      },
      {
        "command": "techdocsEditor.openText",
        "title": "%command.openText%",
        "category": "TechDocs",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "techdocsEditor.openVisual",
          "when": "resourceLangId == markdown && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.openText",
          "when": "activeCustomEditorId == techdocsEditor.visual",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "techdocsEditor.openVisual",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "techdocsEditor.openText",
          "when": "activeCustomEditorId == techdocsEditor.visual"
        }
      ],
      "view/item/context": [
        {
          "command": "techdocsEditor.openVisual",
          "when": "view == techdocsEditor.docs && viewItem == page",
          "group": "inline"
        },
        {
          "command": "techdocsEditor.openVisual",
          "when": "view == techdocsEditor.docs && viewItem == page",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TechDocs Editor",
      "properties": {
        "techdocsEditor.openVisualByDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.openVisualByDefault%"
        },
        "techdocsEditor.images.maxSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%config.images.maxSizeMB%"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "techdocsEditor.docs",
          "name": "%view.docs%",
          "when": "techdocsEditor.hasDocs",
          "icon": "$(book)"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "vscode:prepublish": "node ../../scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@edtroleis/techdocs-editor-core": "0.0.0",
    "@edtroleis/techdocs-editor-ui": "0.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "esbuild": "0.28.2",
    "mocha": "12.0.3"
  },
  "l10n": "./l10n"
}
