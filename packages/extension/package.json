{
  "name": "techdocs-editor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.7.0",
  "private": true,
  "publisher": "edtroleis",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b3d6b",
    "theme": "dark"
  },
  "homepage": "https://github.com/edtroleis/vscode-techdocs-editor#readme",
  "bugs": {
    "url": "https://github.com/edtroleis/vscode-techdocs-editor/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/edtroleis/vscode-techdocs-editor.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "techdocs",
    "backstage",
    "mkdocs",
    "markdown",
    "wysiwyg",
    "docs-as-code",
    "documentation",
    "visual editor",
    "markdownlint"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:**/mkdocs.yml",
    "workspaceContains:**/mkdocs.yaml",
    "workspaceContains:README.md",
    "workspaceContains:docs/**/*.md",
    "workspaceContains:catalog-info.yaml",
    "onUri",
    "onFileSystem:techdocs"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "techdocsEditor.visual",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "techdocsEditor.openVisual",
        "title": "%command.openVisual%",
        "category": "TechDocs",
        "icon": "$(preview)"
      },
      {
        "command": "techdocsEditor.openText",
        "title": "%command.openText%",
        "category": "TechDocs",
        "icon": "$(go-to-file)"
      },
      {
        "command": "techdocsEditor.newPage",
        "title": "%command.newPage%",
        "category": "TechDocs",
        "icon": "$(new-file)"
      },
      {
        "command": "techdocsEditor.newSite",
        "title": "%command.newSite%",
        "category": "TechDocs",
        "icon": "$(book)"
      },
      {
        "command": "techdocsEditor.refreshTemplates",
        "title": "%command.refreshTemplates%",
        "category": "TechDocs",
        "icon": "$(refresh)"
      },
      {
        "command": "techdocsEditor.checkDocs",
        "title": "%command.checkDocs%",
        "category": "TechDocs",
        "icon": "$(checklist)"
      },
      {
        "command": "techdocsEditor.prepareDocs",
        "title": "%command.prepareDocs%",
        "category": "TechDocs",
        "icon": "$(wand)"
      },
      {
        "command": "techdocsEditor.fixFinding",
        "title": "%command.fixFinding%",
        "category": "TechDocs",
        "icon": "$(wand)"
      },
      {
        "command": "techdocsEditor.checkOptions",
        "title": "%command.checkOptions%",
        "category": "TechDocs",
        "icon": "$(gear)"
      },
      {
        "command": "techdocsEditor.openRemote",
        "title": "%command.openRemote%",
        "category": "TechDocs",
        "icon": "$(github)"
      },
      {
        "command": "techdocsEditor.closeRemote",
        "title": "%command.closeRemote%",
        "category": "TechDocs",
        "icon": "$(close)"
      },
      {
        "command": "techdocsEditor.refreshRemote",
        "title": "%command.refreshRemote%",
        "category": "TechDocs",
        "icon": "$(refresh)"
      },
      {
        "command": "techdocsEditor.chooseSites",
        "title": "%command.chooseSites%",
        "category": "TechDocs",
        "icon": "$(list-filter)"
      },
      {
        "command": "techdocsEditor.hideSite",
        "title": "%command.hideSite%",
        "category": "TechDocs",
        "icon": "$(eye-closed)"
      },
      {
        "command": "techdocsEditor.pageHistory",
        "title": "%command.pageHistory%",
        "category": "TechDocs",
        "icon": "$(history)"
      },
      {
        "command": "techdocsEditor.chooseSite",
        "title": "%command.chooseSite%",
        "category": "TechDocs",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "techdocsEditor.refreshMine",
        "title": "%command.refreshMine%",
        "category": "TechDocs",
        "icon": "$(refresh)"
      },
      {
        "command": "techdocsEditor.openMine",
        "title": "%command.openMine%",
        "category": "TechDocs"
      },
      {
        "command": "techdocsEditor.openMinePr",
        "title": "%command.openMinePr%",
        "category": "TechDocs",
        "icon": "$(link-external)"
      },
      {
        "command": "techdocsEditor.signIn",
        "title": "%command.signIn%",
        "category": "TechDocs"
      },
      {
        "command": "techdocsEditor.renameItem",
        "title": "%command.renameItem%",
        "category": "TechDocs",
        "icon": "$(edit)"
      },
      {
        "command": "techdocsEditor.duplicatePage",
        "title": "%command.duplicatePage%",
        "category": "TechDocs",
        "icon": "$(copy)"
      },
      {
        "command": "techdocsEditor.moveItem",
        "title": "%command.moveItem%",
        "category": "TechDocs",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "techdocsEditor.moveUp",
        "title": "%command.moveUp%",
        "category": "TechDocs",
        "icon": "$(arrow-up)"
      },
      {
        "command": "techdocsEditor.moveDown",
        "title": "%command.moveDown%",
        "category": "TechDocs",
        "icon": "$(arrow-down)"
      },
      {
        "command": "techdocsEditor.deleteItem",
        "title": "%command.deleteItem%",
        "category": "TechDocs",
        "icon": "$(trash)"
      },
      {
        "command": "techdocsEditor.newSection",
        "title": "%command.newSection%",
        "category": "TechDocs",
        "icon": "$(new-folder)"
      },
      {
        "command": "techdocsEditor.addToMenu",
        "title": "%command.addToMenu%",
        "category": "TechDocs",
        "icon": "$(add)"
      },
      {
        "command": "techdocsEditor.createMissingPage",
        "title": "%command.createMissingPage%",
        "category": "TechDocs",
        "icon": "$(new-file)"
      },
      {
        "command": "techdocsEditor.removeFromMenu",
        "title": "%command.removeFromMenu%",
        "category": "TechDocs"
      },
      {
        "command": "techdocsEditor.undoTreeEdit",
        "title": "%command.undoTreeEdit%",
        "category": "TechDocs",
        "icon": "$(discard)"
      },
      {
        "command": "techdocsEditor.filterTree",
        "title": "%command.filterTree%",
        "category": "TechDocs",
        "icon": "$(filter)"
      },
      {
        "command": "techdocsEditor.tree.openVisual",
        "title": "%command.treeOpenVisual%",
        "category": "TechDocs",
        "icon": "$(preview)"
      },
      {
        "command": "techdocsEditor.tree.openText",
        "title": "%command.treeOpenText%",
        "category": "TechDocs",
        "icon": "$(markdown)"
      },
      {
        "command": "techdocsEditor.tree.newPage",
        "title": "%command.treeNewPage%",
        "category": "TechDocs",
        "icon": "$(new-file)"
      },
      {
        "command": "techdocsEditor.tree.newSection",
        "title": "%command.treeNewSection%",
        "category": "TechDocs",
        "icon": "$(new-folder)"
      },
      {
        "command": "techdocsEditor.tree.deleteSection",
        "title": "%command.treeDeleteSection%",
        "category": "TechDocs",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "techdocsEditor.openVisual",
          "when": "resourceLangId == markdown && activeEditor == workbench.editors.files.textFileEditor && techdocsEditor.activeIsDocs",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.openText",
          "when": "activeCustomEditorId == techdocsEditor.visual",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.pageHistory",
          "when": "resourceScheme == techdocs && resourceExtname == .md",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "techdocsEditor.openVisual",
          "when": "techdocsEditor.activeIsDocs"
        },
        {
          "command": "techdocsEditor.openText",
          "when": "activeCustomEditorId == techdocsEditor.visual"
        },
        {
          "command": "techdocsEditor.newPage",
          "when": "techdocsEditor.hasDocs || techdocsEditor.hasRemote"
        },
        {
          "command": "techdocsEditor.fixFinding",
          "when": "false"
        },
        {
          "command": "techdocsEditor.closeRemote",
          "when": "false"
        },
        {
          "command": "techdocsEditor.refreshRemote",
          "when": "techdocsEditor.hasRemote"
        },
        {
          "command": "techdocsEditor.chooseSites",
          "when": "techdocsEditor.hasDocs"
        },
        {
          "command": "techdocsEditor.hideSite",
          "when": "false"
        },
        {
          "command": "techdocsEditor.pageHistory",
          "when": "techdocsEditor.hasRemote"
        },
        {
          "command": "techdocsEditor.openMine",
          "when": "false"
        },
        {
          "command": "techdocsEditor.openMinePr",
          "when": "false"
        },
        {
          "command": "techdocsEditor.renameItem",
          "when": "false"
        },
        {
          "command": "techdocsEditor.duplicatePage",
          "when": "false"
        },
        {
          "command": "techdocsEditor.moveItem",
          "when": "false"
        },
        {
          "command": "techdocsEditor.moveUp",
          "when": "false"
        },
        {
          "command": "techdocsEditor.moveDown",
          "when": "false"
        },
        {
          "command": "techdocsEditor.deleteItem",
          "when": "false"
        },
        {
          "command": "techdocsEditor.addToMenu",
          "when": "false"
        },
        {
          "command": "techdocsEditor.createMissingPage",
          "when": "false"
        },
        {
          "command": "techdocsEditor.removeFromMenu",
          "when": "false"
        },
        {
          "command": "techdocsEditor.newSection",
          "when": "techdocsEditor.hasDocs"
        },
        {
          "command": "techdocsEditor.undoTreeEdit",
          "when": "false"
        },
        {
          "command": "techdocsEditor.filterTree",
          "when": "techdocsEditor.hasDocs || techdocsEditor.hasRemote"
        },
        {
          "command": "techdocsEditor.tree.openVisual",
          "when": "false"
        },
        {
          "command": "techdocsEditor.tree.openText",
          "when": "false"
        },
        {
          "command": "techdocsEditor.tree.newPage",
          "when": "false"
        },
        {
          "command": "techdocsEditor.tree.newSection",
          "when": "false"
        },
        {
          "command": "techdocsEditor.tree.deleteSection",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "techdocsEditor.chooseSite",
          "when": "view == techdocsEditor.docs && techdocsEditor.manySites && viewItem =~ /^(site|remote)\\b/",
          "group": "inline@0"
        },
        {
          "command": "techdocsEditor.fixFinding",
          "when": "view == techdocsEditor.check && viewItem == fixable",
          "group": "inline"
        },
        {
          "command": "techdocsEditor.fixFinding",
          "when": "view == techdocsEditor.check && viewItem == fixable",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.checkOptions",
          "when": "view == techdocsEditor.check && viewItem == catalogHint",
          "group": "inline"
        },
        {
          "command": "techdocsEditor.checkOptions",
          "when": "view == techdocsEditor.check && viewItem == catalogHint",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.refreshRemote",
          "when": "view == techdocsEditor.docs && viewItem =~ /^remote\\b/",
          "group": "inline@1"
        },
        {
          "command": "techdocsEditor.closeRemote",
          "when": "view == techdocsEditor.docs && viewItem =~ /^remote\\b/",
          "group": "inline@2"
        },
        {
          "command": "techdocsEditor.refreshRemote",
          "when": "view == techdocsEditor.docs && viewItem =~ /^remote\\b/",
          "group": "navigation@1"
        },
        {
          "command": "techdocsEditor.closeRemote",
          "when": "view == techdocsEditor.docs && viewItem =~ /^remote\\b/",
          "group": "navigation@2"
        },
        {
          "command": "techdocsEditor.hideSite",
          "when": "view == techdocsEditor.docs && viewItem =~ /^site\\b/",
          "group": "4_site@1"
        },
        {
          "command": "techdocsEditor.openMinePr",
          "when": "view == techdocsEditor.mine && viewItem == mineWithPr",
          "group": "inline"
        },
        {
          "command": "techdocsEditor.openMinePr",
          "when": "view == techdocsEditor.mine && viewItem == mineWithPr",
          "group": "navigation"
        },
        {
          "command": "techdocsEditor.newPage",
          "when": "view == techdocsEditor.docs && (viewItem =~ /^section\\b/ || viewItem =~ /^(site|remote)\\b/)",
          "group": "inline@1"
        },
        {
          "command": "techdocsEditor.addToMenu",
          "when": "view == techdocsEditor.docs && viewItem =~ /\\boutside\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "inline@1"
        },
        {
          "command": "techdocsEditor.createMissingPage",
          "when": "view == techdocsEditor.docs && viewItem =~ /^missing\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "inline@1"
        },
        {
          "command": "techdocsEditor.newPage",
          "when": "view == techdocsEditor.docs && viewItem =~ /^(site|remote)\\b/",
          "group": "2_new@1"
        },
        {
          "command": "techdocsEditor.newSection",
          "when": "view == techdocsEditor.docs && viewItem =~ /^site\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "2_new@2"
        },
        {
          "submenu": "techdocsEditor.itemMenu",
          "when": "view == techdocsEditor.docs && (viewItem =~ /^page\\b/ || viewItem =~ /^section\\b/)",
          "group": "inline@9"
        },
        {
          "command": "techdocsEditor.tree.openVisual",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/",
          "group": "1_open@1"
        },
        {
          "command": "techdocsEditor.tree.openText",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/",
          "group": "1_open@2"
        },
        {
          "command": "techdocsEditor.pageHistory",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/ && techdocsEditor.hasRemote",
          "group": "1_open@3"
        },
        {
          "command": "techdocsEditor.tree.newPage",
          "when": "view == techdocsEditor.docs && viewItem =~ /^section\\b/",
          "group": "2_new@1"
        },
        {
          "command": "techdocsEditor.tree.newSection",
          "when": "view == techdocsEditor.docs && viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "2_new@2"
        },
        {
          "command": "techdocsEditor.renameItem",
          "when": "view == techdocsEditor.docs && (viewItem =~ /^page\\b/ || (viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/))",
          "group": "3_edit@1"
        },
        {
          "command": "techdocsEditor.duplicatePage",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@2"
        },
        {
          "command": "techdocsEditor.addToMenu",
          "when": "view == techdocsEditor.docs && viewItem =~ /\\boutside\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@3"
        },
        {
          "command": "techdocsEditor.createMissingPage",
          "when": "view == techdocsEditor.docs && viewItem =~ /^missing\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "2_new@1"
        },
        {
          "command": "techdocsEditor.removeFromMenu",
          "when": "view == techdocsEditor.docs && viewItem =~ /^missing\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "5_delete@1"
        },
        {
          "command": "techdocsEditor.moveItem",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/ && viewItem =~ /^(?!.*\\b(home|outside)\\b)/",
          "group": "3_edit@4"
        },
        {
          "command": "techdocsEditor.moveUp",
          "when": "view == techdocsEditor.docs && viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@5"
        },
        {
          "command": "techdocsEditor.moveDown",
          "when": "view == techdocsEditor.docs && viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@6"
        },
        {
          "command": "techdocsEditor.deleteItem",
          "when": "view == techdocsEditor.docs && viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/ && viewItem =~ /^(?!.*\\bhome\\b)/",
          "group": "5_delete@1"
        },
        {
          "command": "techdocsEditor.tree.deleteSection",
          "when": "view == techdocsEditor.docs && viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "5_delete@2"
        }
      ],
      "view/title": [
        {
          "command": "techdocsEditor.chooseSite",
          "when": "view == techdocsEditor.docs && (techdocsEditor.hasDocs || techdocsEditor.hasRemote)",
          "group": "navigation@0"
        },
        {
          "command": "techdocsEditor.filterTree",
          "when": "view == techdocsEditor.docs && (techdocsEditor.hasDocs || techdocsEditor.hasRemote)",
          "group": "navigation@1"
        },
        {
          "command": "techdocsEditor.newPage",
          "when": "view == techdocsEditor.docs && (techdocsEditor.hasDocs || techdocsEditor.hasRemote)",
          "group": "navigation@2"
        },
        {
          "command": "techdocsEditor.newSection",
          "when": "view == techdocsEditor.docs && techdocsEditor.hasDocs",
          "group": "navigation@3"
        },
        {
          "command": "techdocsEditor.chooseSites",
          "when": "view == techdocsEditor.docs && techdocsEditor.hasDocs",
          "group": "2_sites@1"
        },
        {
          "command": "techdocsEditor.newSite",
          "when": "view == techdocsEditor.docs",
          "group": "1_create@1"
        },
        {
          "command": "techdocsEditor.openRemote",
          "when": "view == techdocsEditor.docs",
          "group": "1_create@3"
        },
        {
          "command": "techdocsEditor.refreshTemplates",
          "when": "view == techdocsEditor.docs",
          "group": "1_create@2"
        },
        {
          "command": "techdocsEditor.checkDocs",
          "when": "view == techdocsEditor.check",
          "group": "navigation@1"
        },
        {
          "command": "techdocsEditor.prepareDocs",
          "when": "view == techdocsEditor.check",
          "group": "navigation@2"
        },
        {
          "command": "techdocsEditor.checkOptions",
          "when": "view == techdocsEditor.check",
          "group": "navigation@3"
        },
        {
          "command": "techdocsEditor.refreshMine",
          "when": "view == techdocsEditor.mine",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "techdocsEditor.newPage",
          "when": "explorerResourceIsFolder && techdocsEditor.hasDocs",
          "group": "navigation@9"
        },
        {
          "command": "techdocsEditor.newSite",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "techdocsEditor.itemMenu": [
        {
          "command": "techdocsEditor.tree.openVisual",
          "when": "viewItem =~ /^page\\b/",
          "group": "1_open@1"
        },
        {
          "command": "techdocsEditor.tree.openText",
          "when": "viewItem =~ /^page\\b/",
          "group": "1_open@2"
        },
        {
          "command": "techdocsEditor.pageHistory",
          "when": "viewItem =~ /^page\\b/ && techdocsEditor.hasRemote",
          "group": "1_open@3"
        },
        {
          "command": "techdocsEditor.tree.newPage",
          "when": "viewItem =~ /^section\\b/",
          "group": "2_new@1"
        },
        {
          "command": "techdocsEditor.tree.newSection",
          "when": "viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "2_new@2"
        },
        {
          "command": "techdocsEditor.renameItem",
          "when": "(viewItem =~ /^page\\b/ || (viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/))",
          "group": "3_edit@1"
        },
        {
          "command": "techdocsEditor.duplicatePage",
          "when": "viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@2"
        },
        {
          "command": "techdocsEditor.addToMenu",
          "when": "viewItem =~ /\\boutside\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@3"
        },
        {
          "command": "techdocsEditor.moveItem",
          "when": "viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/ && viewItem =~ /^(?!.*\\b(home|outside)\\b)/",
          "group": "3_edit@4"
        },
        {
          "command": "techdocsEditor.moveUp",
          "when": "viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@5"
        },
        {
          "command": "techdocsEditor.moveDown",
          "when": "viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "3_edit@6"
        },
        {
          "command": "techdocsEditor.deleteItem",
          "when": "viewItem =~ /^page\\b/ && viewItem =~ /\\blocal\\b/ && viewItem =~ /^(?!.*\\bhome\\b)/",
          "group": "5_delete@1"
        },
        {
          "command": "techdocsEditor.tree.deleteSection",
          "when": "viewItem =~ /^section\\b/ && viewItem =~ /\\blocal\\b/",
          "group": "5_delete@2"
        }
      ]
    },
    "configuration": {
      "title": "TechDocs Editor",
      "properties": {
        "techdocsEditor.mode": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "remote"
          ],
          "default": "auto",
          "markdownEnumDescriptions": [
            "%config.mode.auto%",
            "%config.mode.local%",
            "%config.mode.remote%"
          ],
          "markdownDescription": "%config.mode%"
        },
        "techdocsEditor.openVisualByDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.openVisualByDefault%"
        },
        "techdocsEditor.images.maxSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%config.images.maxSizeMB%"
        },
        "techdocsEditor.templates.paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.templates.paths%"
        },
        "techdocsEditor.templates.repository": {
          "type": "string",
          "default": "",
          "pattern": "^$|^([\\w.-]+\\.[\\w.-]+/)?[\\w.-]+/[\\w.-]+(/[^@]+)?(@.+)?$",
          "markdownDescription": "%config.templates.repository%"
        },
        "techdocsEditor.templates.builtIn": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.templates.builtIn%"
        },
        "techdocsEditor.catalog": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "off"
          ],
          "enumDescriptions": [
            "%config.catalog.auto%",
            "%config.catalog.required%",
            "%config.catalog.off%"
          ],
          "default": "auto",
          "markdownDescription": "%config.catalog%"
        },
        "techdocsEditor.local.publishPanel": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.local.publishPanel%"
        },
        "techdocsEditor.github.host": {
          "type": "string",
          "default": "github.com",
          "markdownDescription": "%config.github.host%"
        },
        "techdocsEditor.github.scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "repo"
          ],
          "markdownDescription": "%config.github.scopes%"
        },
        "techdocsEditor.branchPattern": {
          "type": "string",
          "default": "docs/{login}/{path}",
          "markdownDescription": "%config.branchPattern%"
        },
        "techdocsEditor.drafts.skipCi": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.drafts.skipCi%"
        },
        "techdocsEditor.verification.mode": {
          "type": "string",
          "enum": [
            "auto",
            "pipeline",
            "editor"
          ],
          "default": "auto",
          "markdownEnumDescriptions": [
            "%config.verification.mode.auto%",
            "%config.verification.mode.pipeline%",
            "%config.verification.mode.editor%"
          ],
          "markdownDescription": "%config.verification.mode%"
        },
        "techdocsEditor.verification.startTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "markdownDescription": "%config.verification.startTimeoutSeconds%"
        },
        "techdocsEditor.verification.checkHelp": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "%config.verification.checkHelp%"
        },
        "techdocsEditor.polling.intervalSeconds": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "markdownDescription": "%config.polling.intervalSeconds%"
        },
        "techdocsEditor.polling.idleIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "markdownDescription": "%config.polling.idleIntervalSeconds%"
        },
        "techdocsEditor.sites": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "scope": "resource",
          "markdownDescription": "%config.sites%"
        },
        "techdocsEditor.maintainer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.maintainer%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "techdocs",
          "title": "%viewContainer.techdocs%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "techdocs": [
        {
          "type": "webview",
          "id": "techdocsEditor.preview",
          "name": "%view.preview%",
          "when": "techdocsEditor.preview",
          "icon": "$(preview)"
        },
        {
          "id": "techdocsEditor.docs",
          "name": "%view.docs%",
          "when": "!techdocsEditor.preview",
          "icon": "$(book)"
        },
        {
          "id": "techdocsEditor.mine",
          "name": "%view.mine%",
          "when": "techdocsEditor.hasMine",
          "icon": "$(git-pull-request-draft)"
        },
        {
          "type": "webview",
          "id": "techdocsEditor.publish",
          "name": "%view.publish%",
          "when": "techdocsEditor.hasDocs && techdocsEditor.publishPanel || techdocsEditor.remoteDocs",
          "icon": "$(git-pull-request)",
          "visibility": "collapsed"
        },
        {
          "id": "techdocsEditor.check",
          "name": "%view.maintenance%",
          "when": "techdocsEditor.hasDocs && (config.techdocsEditor.maintainer || techdocsEditor.checkAsked)",
          "icon": "$(tools)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.noFolder%",
        "when": "workbenchState == empty"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.empty%",
        "when": "workbenchState != empty && techdocsEditor.scanned && !techdocsEditor.hasDocs && !techdocsEditor.canPrepare && !techdocsEditor.hasRemote"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.chooseSite%",
        "when": "techdocsEditor.needsSite"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.prepare.intro%",
        "when": "techdocsEditor.canPrepare"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.prepare.readme%",
        "when": "techdocsEditor.canPrepare && techdocsEditor.found.readme"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.prepare.docs%",
        "when": "techdocsEditor.canPrepare && techdocsEditor.found.docs"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.prepare.catalog%",
        "when": "techdocsEditor.canPrepare && techdocsEditor.found.catalog"
      },
      {
        "view": "techdocsEditor.docs",
        "contents": "%viewsWelcome.prepare.action%",
        "when": "techdocsEditor.canPrepare"
      },
      {
        "view": "techdocsEditor.check",
        "contents": "%viewsWelcome.check%"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "site",
            "title": "%walkthrough.site.title%",
            "description": "%walkthrough.site.description%",
            "media": {
              "markdown": "%walkthrough.site.media%"
            },
            "completionEvents": [
              "onCommand:techdocsEditor.newSite",
              "onCommand:techdocsEditor.prepareDocs",
              "onContext:techdocsEditor.hasDocs"
            ]
          },
          {
            "id": "sidebar",
            "title": "%walkthrough.sidebar.title%",
            "description": "%walkthrough.sidebar.description%",
            "media": {
              "markdown": "%walkthrough.sidebar.media%"
            },
            "completionEvents": [
              "onView:techdocsEditor.docs"
            ]
          },
          {
            "id": "page",
            "title": "%walkthrough.page.title%",
            "description": "%walkthrough.page.description%",
            "media": {
              "markdown": "%walkthrough.page.media%"
            },
            "completionEvents": [
              "onCommand:techdocsEditor.newPage"
            ]
          },
          {
            "id": "visual",
            "title": "%walkthrough.visual.title%",
            "description": "%walkthrough.visual.description%",
            "media": {
              "markdown": "%walkthrough.visual.media%"
            },
            "completionEvents": [
              "onCommand:techdocsEditor.openVisual",
              "onSettingChanged:techdocsEditor.openVisualByDefault"
            ]
          },
          {
            "id": "check",
            "title": "%walkthrough.check.title%",
            "description": "%walkthrough.check.description%",
            "media": {
              "markdown": "%walkthrough.check.media%"
            },
            "completionEvents": [
              "onCommand:techdocsEditor.checkDocs",
              "onView:techdocsEditor.check"
            ]
          },
          {
            "id": "publish",
            "title": "%walkthrough.publish.title%",
            "description": "%walkthrough.publish.description%",
            "media": {
              "markdown": "%walkthrough.publish.media%"
            },
            "completionEvents": [
              "onSettingChanged:techdocsEditor.local.publishPanel"
            ]
          },
          {
            "id": "company",
            "title": "%walkthrough.company.title%",
            "description": "%walkthrough.company.description%",
            "media": {
              "markdown": "%walkthrough.company.media%"
            },
            "completionEvents": [
              "onSettingChanged:techdocsEditor.templates.repository"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "techdocsEditor.renameItem",
        "key": "f2",
        "when": "focusedView == techdocsEditor.docs && !inputFocus"
      },
      {
        "command": "techdocsEditor.deleteItem",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == techdocsEditor.docs && !inputFocus && !treeElementHasChild"
      },
      {
        "command": "techdocsEditor.moveUp",
        "key": "alt+up",
        "when": "focusedView == techdocsEditor.docs && !inputFocus"
      },
      {
        "command": "techdocsEditor.moveDown",
        "key": "alt+down",
        "when": "focusedView == techdocsEditor.docs && !inputFocus"
      },
      {
        "command": "techdocsEditor.undoTreeEdit",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == techdocsEditor.docs && !inputFocus"
      },
      {
        "command": "techdocsEditor.tree.deleteSection",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == techdocsEditor.docs && !inputFocus && treeElementHasChild"
      },
      {
        "command": "techdocsEditor.tree.openVisual",
        "key": "enter",
        "when": "focusedView == techdocsEditor.docs && !inputFocus && !treeElementHasChild"
      }
    ],
    "submenus": [
      {
        "id": "techdocsEditor.itemMenu",
        "label": "%submenu.itemMenu%",
        "icon": "$(ellipsis)"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "vscode:prepublish": "node ../../scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@edtroleis/techdocs-editor-core": "0.0.0",
    "@edtroleis/techdocs-editor-ui": "0.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "esbuild": "0.28.2",
    "mocha": "12.0.3"
  },
  "l10n": "./l10n"
}
